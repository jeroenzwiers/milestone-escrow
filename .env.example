# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Same client id, exposed to the browser for the JS SDK v6 button
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Sandbox *personal* account that plays the freelancer (receives payouts)
FREELANCER_PAYPAL_EMAIL=

# Webhook id from developer.paypal.com > your app > Webhooks (needs a public URL, e.g. after deploying)
PAYPAL_WEBHOOK_ID=

# Storage. Leave empty to use a local JSON file in data/ (development).
# Set to a Postgres URL (e.g. Neon, pooled connection) for a deployment.
DATABASE_URL=
# Signs short-lived file URLs. Optional with a single instance; set it when running several.
FILE_URL_SECRET=

# Platform settings
CURRENCY=EUR
PLATFORM_FEE_PERCENT=5
# How long the client can object after the AI verified a delivery (short for demos)
CHALLENGE_WINDOW_MINUTES=3

# Reverse proxies in front of the app that append to X-Forwarded-For (0 locally, 1 on Render).
# Used to find the real client IP for the AI rate limit.
TRUSTED_PROXY_HOPS=0

# Optional: raises GitHub's API rate limit for reading pull requests (a token with no scopes is enough)
GITHUB_TOKEN=

# Used from week 2 on (milestone extraction + verification agent)
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (Console > Settings > Workspaces, wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
